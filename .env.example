NODE_ENV=development
PORT=3000

DB_CONNECTION_STRING=postgresql://usuario:password@host:5432/database
DB_SSL=true

CORS_ORIGIN=http://localhost:5173

# Reemplazar por un secreto aleatorio propio de al menos 32 caracteres.
JWT_SECRET=reemplazar-por-un-secreto-aleatorio-seguro
JWT_EXPIRES_IN=8h

NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=InmuConnect/1.0 (contacto: correo@ejemplo.com)
NOMINATIM_TIMEOUT_MS=5000
