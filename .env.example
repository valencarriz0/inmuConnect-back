NODE_ENV=development
PORT=3000

DB_CONNECTION_STRING=postgresql://usuario:password@host:5432/database
DB_SSL=true

CORS_ORIGIN=http://localhost:5173

# Reemplazar por un secreto aleatorio propio de al menos 32 caracteres.
JWT_SECRET=reemplazar-por-un-secreto-aleatorio-seguro
JWT_EXPIRES_IN=8h

APP_URL=http://localhost:5173
SMTP_HOST=smtp.ejemplo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=usuario-smtp
SMTP_PASSWORD=reemplazar-por-la-contrasena-smtp
MAIL_FROM=InmuConnect <no-reply@ejemplo.com>
EMAIL_VERIFICATION_TTL_MINUTES=1440
PASSWORD_RESET_TTL_MINUTES=30

NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=InmuConnect/1.0 (contacto: correo@ejemplo.com)
NOMINATIM_TIMEOUT_MS=5000

# Credenciales exclusivas del backend. No exponer la secret key al frontend.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SECRET_KEY=reemplazar-por-la-secret-key-del-backend
# Alternativa legacy opcional: SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=property-images
